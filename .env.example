# UniCare - plantilla de variables de entorno.
#
#   cp .env.example .env
#
# .env NUNCA se versiona (ver .gitignore). Este archivo no contiene, y no debe
# contener jamas, ningun valor real: solo placeholders.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambiar-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
DJANGO_LOG_LEVEL=INFO
DJANGO_LANGUAGE_CODE=es-co
DJANGO_TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Consumidas por el servicio `db` de docker-compose.
POSTGRES_USER=unicare
POSTGRES_PASSWORD=cambiar-esta-password
POSTGRES_DB=unicare
POSTGRES_PORT=5432

# Consumida por Django. En docker-compose el host es `db`; en local, `localhost`.
DATABASE_URL=postgres://unicare:cambiar-esta-password@db:5432/unicare
DATABASE_CONN_MAX_AGE=600

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540

# Horas antes de la cita a las que se envia cada recordatorio.
REMINDER_OFFSETS_HOURS=48,24
# Cada cuantos minutos revisa `beat` si hay recordatorios que enviar.
REMINDER_DISPATCH_MINUTES=15
# Backend de notificaciones. El de por defecto solo registra, no envia nada.
NOTIFICATION_BACKEND=apps.core.services.notifications.LoggingNotificationBackend

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
# NUNCA subir la clave real al repositorio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT=15

# ---------------------------------------------------------------------------
# API externa de farmacos
# ---------------------------------------------------------------------------
# Obligatoria y sin valor por defecto: la URL documentada es un placeholder
# (docs/DECISIONS.md, C-07). Sustituir por la URL real cuando este disponible.
# Solo el host: la ruta /v1/farmacos es parte del contrato de la API.
FARMACOS_API_BASE_URL=https://api.example.invalid
FARMACOS_API_TIMEOUT=5
FARMACOS_CACHE_TTL=900
# La API es hoy publica. Dejar vacio salvo que en el futuro exija credencial.
FARMACOS_API_KEY=

# ---------------------------------------------------------------------------
# Sentry
# ---------------------------------------------------------------------------
# Vacio = Sentry desactivado. El DSN nunca va hardcodeado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=1440

# ---------------------------------------------------------------------------
# API / CORS
# ---------------------------------------------------------------------------
API_PAGE_SIZE=25
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Varios
# ---------------------------------------------------------------------------
# Usuario tecnico responsable de las operaciones automaticas (docs/DECISIONS.md, C-04).
SYSTEM_USERNAME=system
# Formato admitido del numero de identificacion (docs/DECISIONS.md, DEC-17).
# El DER no lo define; ajustar si la normativa local exige un formato concreto.
IDENTIFICATION_NUMBER_PATTERN=^[A-Za-z0-9][A-Za-z0-9.\-]{1,49}$

# Carga masiva: mapeo `cabecera del archivo -> columna canonica` (DEC-33).
# Nadie define como se llaman las columnas del archivo, asi que aqui se adapta
# el contrato a los archivos reales SIN tocar codigo. Vacio = se exigen los
# nombres canonicos. Ver docs/CARGA_MASIVA.md.
# MASSIVE_LOAD_COLUMN_ALIASES={"numero_identificacion":"identification_number","nombres":"first_name","apellidos":"last_name","patologia":"pathology"}
MASSIVE_LOAD_COLUMN_ALIASES=
WEB_PORT=8000

# ---------------------------------------------------------------------------
# Solo produccion
# ---------------------------------------------------------------------------
# El stack de produccion lee `.env.production`, no `.env`. Esta plantilla sirve
# para los dos:  cp .env.example .env.production  y ajustar los valores.
# Ninguno de los dos se versiona.
#
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=60
#
# Formato del log de acceso de gunicorn. El de por defecto del entrypoint NO
# registra la query string: `?search=...` de una busqueda de pacientes acabaria
# escrito en el log de cada peticion.
# GUNICORN_ACCESS_LOG_FORMAT=
#
# Recoger estaticos al arrancar. Por defecto NO: en produccion la API responde
# solo JSON y no hay nada que servir.
# COLLECT_STATIC=0
#
# Sonda de salud del contenedor (scripts/healthcheck.py). Apuntar a
# /api/v1/health/ready/ si quien consulta es un balanceador.
# HEALTHCHECK_PATH=/api/v1/health/
# HEALTHCHECK_TIMEOUT=5
#
# Estado de celery beat. En el contenedor va a un volumen: si el fichero se
# pierde en cada reinicio, beat vuelve a disparar el despacho al arrancar.
# CELERY_BEAT_SCHEDULE_FILENAME=/var/lib/unicare/celerybeat-schedule
#
# Imagen que despliega docker-compose.prod.yml.
# UNICARE_IMAGE=unicare:latest
